{
  "private": true,
  "name": "peardrop-mobile",
  "version": "0.5.0",
  "description": "PearDrop for Android and iOS",
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npm install && npm run bundle:backend",
    "dev": "npm run bundle:backend && expo start",
    "dev:android": "npm run bundle:backend && expo run:android",
    "dev:ios": "npm run bundle:backend && expo run:ios",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "bundle:backend": "bare-pack --preset mobile -o app/app.bundle.mjs backend/backend.mjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:copy:selftest": "node scripts/check-copy.mjs --selftest",
    "pearkit:sync": "node scripts/pearkit-sync.mjs",
    "pearkit:check": "node scripts/pearkit-sync.mjs --check",
    "deliver:android": "bash scripts/deliver-apk.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "b4a": "^1.7.3",
    "bare-fs": "^4.6.0",
    "bare-path": "^3.0.0",
    "bare-rpc": "^1.1.0",
    "corestore": "^7.9.2",
    "expo": "~54.0.37",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "^1.0.9",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "^18.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.7",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-screen-orientation": "~9.0.9",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-system-ui": "^6.0.7",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "hypercore-crypto": "^3.6.1",
    "hyperdht": "^6.29.6",
    "hyperdrive": "^13.3.2",
    "hyperswarm": "^4.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-b4a": "^0.0.4",
    "react-native-bare-kit": "^0.11.0",
    "react-native-fs": "^2.20.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "bare-pack": "^1.5.1",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.18",
    "prettier": "^3.3.3",
    "react-test-renderer": "^19.1.4",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  }
}
