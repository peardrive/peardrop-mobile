<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <!--
    Photo-picker permission shape.

    Goal: on Android 14+ the system PhotoPicker shows a "PearDrop only
    has access to a few photos" banner whenever the app declares ANY
    media-access permission. PickVisualMedia (the contract
    expo-image-picker uses) is permissionless on Android 13+, so on
    those versions we want NO media permissions at all.

    But on Android ≤12 (API 32), expo-image-picker falls back to
    MediaStore which DOES need READ_EXTERNAL_STORAGE — stripping it
    entirely (the first attempt) broke the picker on older devices.

    Compromise: cap the legacy storage perms to API 32 (Android 12) and
    below using android:maxSdkVersion. tools:replace forces our cap to
    win over the un-capped permission expo-image-picker declares in its
    library manifest. On API ≥ 33 the perm isn't declared → no banner;
    on API ≤ 32 it's declared → legacy MediaStore path works.

    READ_MEDIA_IMAGES / READ_MEDIA_VIDEO / READ_MEDIA_VISUAL_USER_SELECTED
    only exist on Android 13+ where we don't need them (PhotoPicker is
    permissionless). Keep these stripped.
  -->
  <uses-permission
    android:name="android.permission.READ_EXTERNAL_STORAGE"
    android:maxSdkVersion="32"
    tools:replace="android:maxSdkVersion"/>
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28"
    tools:replace="android:maxSdkVersion"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <!--
      Notification small icon + accent. Hand-written to match
      exactly what expo-notifications' config plugin emits at prebuild
      (plugin/build/withNotificationsAndroid.js) so a future regeneration
      produces the same four entries rather than a diff:
        NOTIFICATION_ICON       = 'notification_icon'       -> @drawable/…
        NOTIFICATION_ICON_COLOR = 'notification_icon_color' -> @color/…
      The plugin writes both the FCM and the expo-local key for each,
      so all four are listed even though this app has no FCM.
      Mirrored in app.json's expo-notifications plugin entry — same
      belt-and-braces pattern used for the peardrop:// scheme.
    -->
    <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="expo.modules.notifications.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="peardrop.mobile"/>
        <!--
          The share-link scheme the engine actually mints
          (`peardrop://<64-hex>`, hyperdrive-engine.mjs createShareLink).
          `peardrop.mobile` stays first and untouched — expo-router and the
          dev client resolve their root URL from it. Android matches an
          intent against ANY <data> scheme in the filter, so listing both
          here needs no second intent-filter.

          BROWSABLE means any web page can fire a peardrop:// URL at us, so
          the RN side treats these links as untrusted: strictly validated at
          the boundary and always routed to the confirm-first share preview,
          never to a download.
        -->
        <data android:scheme="peardrop"/>
      </intent-filter>
    </activity>
  </application>
</manifest>