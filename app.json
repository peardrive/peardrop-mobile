{
  "expo": {
    "name": "PearDrop",
    "slug": "peardrop-mobile",
    "version": "0.2.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": ["peardrop.mobile", "peardrop"],
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*", "assets/demo/**/*"],
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f2238"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anjouinc.peardrop"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/monochrome-icon.png",
        "backgroundColor": "#201e1f"
      },
      "package": "com.anjouinc.peardrop",
      "versionCode": 2
    },
    "plugins": [
      [
        "expo-router"
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PearDrop to use the camera for scanning share QR codes."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#a8cf3a"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-video"
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow PearDrop to access your photos so you can share them."
        }
      ]
    ]
  }
}
